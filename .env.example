# Placeholders only. Copy to .env (gitignored) if you want, fill in locally, and load it into your
# shell with:  set -a; source .env; set +a
# The project never reads this file or prints these values; wandb reads WANDB_API_KEY itself.
# Simpler alternative: run `wandb login` once and leave WANDB_API_KEY unset.

WANDB_API_KEY=<your-wandb-api-key>
# Used when logging.wandb_entity is null in the config:
WANDB_ENTITY=<your-wandb-username-or-team>

# Leave this unset. If set to 1, unsupported MPS ops silently run on the CPU.
# PYTORCH_ENABLE_MPS_FALLBACK=1
